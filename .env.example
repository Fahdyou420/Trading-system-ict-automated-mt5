# AI Configuration
USE_LOCAL_AI="false"
OLLAMA_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="llama3"

# OPENROUTER_API_KEY: Required if USE_LOCAL_AI is false.
OPENROUTER_API_KEY=""

# APP_URL: The public URL of your app.
# For local network access, use your PC's local IP (e.g., http://192.168.1.50:3000)
# For mobile access via no-ip, use your DDNS address (e.g., http://yourname.no-ip.org:3000)
APP_URL="http://localhost:3000"

# OLLAMA_URL: Optional, if you want to use local models (e.g., http://localhost:11434)
OLLAMA_URL="http://localhost:11434"
